# --- Приложение ---
APP_PORT=7777
SECRET_KEY=change-me-to-random-64-hex

# --- База данных ---
POSTGRES_DB=itrainterview
POSTGRES_USER=itraint
POSTGRES_PASSWORD=***

# --- ИИ-помощник (OpenAI-совместимый интерфейс llama.cpp) ---
LLM_BASE_URL=http://192.168.2.83:8080/v1
LLM_MODEL=GigaChat3.1-10B-A1.8B-q4_K_M.gguf
LLM_API_KEY=
LLM_TI…c=120

# --- Песочница (запуск кода студента) ---
# Абсолютный путь к каталогу рабочих директорий на ХОСТЕ (виден docker-демону)
SANDBOX_HOST_DIR=/opt/itrainterview/sandbox-work
SANDBOX_TIMEOUT_SEC=5
SANDBOX_MEMORY_MB=256

# --- Первый администратор (создаётся при старте, если ещё не существует) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=***
ADMIN_USERNAME=admin

# --- Прочее ---
SEED_ON_START=true
CORS_ORIGINS=http://localhost:5173
